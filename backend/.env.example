# PostgreSQL connection string (Neon, Vercel Postgres, or local)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# Direct connection for Prisma migrations (Neon requires this)
DIRECT_URL=

# JWT secret for signing tokens (generate a strong random string)
JWT_SECRET=

# AI service URL (local dev or deployed)
AI_SERVICE_URL=http://localhost:8001

# AI provider configuration
AI_PROVIDER=gemini

# Gemini API key (for backend direct calls or AI module)
GEMINI_API_KEY=

# OpenAI API key (optional, for provider abstraction)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google reCAPTCHA v2 secret key (for registration validation)
RECAPTCHA_SECRET_KEY=

# Server port (default: 8080)
PORT=8080

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Node environment (development, production)
NODE_ENV=development
