// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id          Int             @id @default(autoincrement())
  participant_code String          @unique @default(uuid())
  first_name       String?         @db.VarChar(100)
  last_name        String?         @db.VarChar(100)
  email            String          @unique @db.VarChar(120)
  password_hash    String          @db.VarChar(255)
  age              Int?
  education_level  EducationLevel?
  gender           Gender?
  math_level       MathLevel?
  goal             String?         @db.VarChar(150)
  role             Role            @default(student)
  created_at       DateTime        @default(now())

  sessions          Session[]
  activities        Activity[]
  assessments       Assessment[]
  surveys           Survey[]
  ai_feedback       AIFeedback[]
  infrastructure    Infrastructure[]
  consents          Consent[]
  assignments       Assignment[]
  featureFlag       FeatureFlag?
  surveySubmissions SurveySubmission[]
  events            Event[]
  practiceSummaries PracticeSummary[]
}

model Session {
  session_id         Int       @id @default(autoincrement())
  user_id            Int
  start_time         DateTime
  end_time           DateTime?
  total_time_seconds Int?
  device             Device?

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Activity {
  activity_id      Int             @id @default(autoincrement())
  user_id          Int
  activity_type    ActivityType
  difficulty_level DifficultyLevel
  attempts         Int             @default(0)
  correct_answers  Int             @default(0)
  status           Status          @default(pending)
  duration_seconds Int?
  domain           String?         @db.VarChar(100)
  competency       String?         @db.VarChar(100)
  occurred_at      DateTime        @default(now())
  created_at       DateTime        @default(now())

  user        User         @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  ai_feedback AIFeedback[]

  @@index([user_id])
}

model Assessment {
  assessment_id   Int            @id @default(autoincrement())
  user_id         Int
  assessment_type AssessmentType
  test_version    String         @default("v1") @db.VarChar(50)
  total_score     Int?
  started_at      DateTime?
  finished_at     DateTime?
  created_at      DateTime       @default(now())

  user      User                 @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  responses AssessmentResponse[]

  @@index([user_id])
}

model Survey {
  survey_id         Int              @id @default(autoincrement())
  user_id           Int
  perceived_utility Int?             @db.SmallInt
  ease_of_use       Int?             @db.SmallInt
  motivation        Int?             @db.SmallInt
  autonomy          Int?             @db.SmallInt
  comments          String?          @db.Text
  timepoint         SurveyTimepoint?
  created_at        DateTime         @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model AIFeedback {
  log_id       Int         @id @default(autoincrement())
  user_id      Int
  activity_id  Int?
  ai_message   String      @db.Text
  message_type MessageType
  prompt_hash  String?     @db.VarChar(128)
  token_count  Int?
  created_at   DateTime    @default(now())

  user     User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  activity Activity? @relation(fields: [activity_id], references: [activity_id], onDelete: Cascade)

  @@index([user_id])
  @@index([activity_id])
}

model Infrastructure {
  access_id           Int                @id @default(autoincrement())
  user_id             Int
  device              Device
  internet_connection InternetConnection
  observations        String?            @db.Text

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Consent {
  consent_id       Int      @id @default(autoincrement())
  user_id          Int
  accepted         Boolean
  document_version String   @db.VarChar(50)
  accepted_at      DateTime @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model Assignment {
  assignment_id Int              @id @default(autoincrement())
  user_id       Int
  group         AssignmentGroup
  method        AssignmentMethod
  seed          String?          @db.VarChar(50)
  assigned_at   DateTime         @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model FeatureFlag {
  feature_flag_id Int      @id @default(autoincrement())
  user_id         Int      @unique
  chatbot         Boolean  @default(false)
  adaptativo      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model AssessmentItem {
  item_id      Int      @id @default(autoincrement())
  test_version String   @db.VarChar(50)
  domain       String?  @db.VarChar(100)
  competency   String?  @db.VarChar(100)
  stem         String   @db.Text
  options      Json
  correct_key  String   @db.VarChar(10)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  responses AssessmentResponse[]
}

model AssessmentResponse {
  response_id   Int      @id @default(autoincrement())
  assessment_id Int
  item_id       Int
  answer        String?  @db.VarChar(50)
  is_correct    Boolean?
  created_at    DateTime @default(now())

  assessment Assessment     @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  item       AssessmentItem @relation(fields: [item_id], references: [item_id])

  @@index([assessment_id])
  @@index([item_id])
}

model SurveyItem {
  survey_item_id Int              @id @default(autoincrement())
  instrument     SurveyInstrument
  subscale       String?          @db.VarChar(100)
  version        String           @db.VarChar(50)
  prompt         String           @db.Text
  sort_order     Int?
  created_at     DateTime         @default(now())

  responses SurveyResponse[]
}

model SurveySubmission {
  survey_submission_id Int              @id @default(autoincrement())
  user_id              Int
  instrument           SurveyInstrument
  version              String           @db.VarChar(50)
  timepoint            SurveyTimepoint  @default(exit)
  completed            Boolean          @default(true)
  submitted_at         DateTime         @default(now())

  user      User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  responses SurveyResponse[]

  @@index([user_id])
}

model SurveyResponse {
  survey_response_id   Int      @id @default(autoincrement())
  survey_submission_id Int
  survey_item_id       Int
  value                Int?
  created_at           DateTime @default(now())

  submission SurveySubmission @relation(fields: [survey_submission_id], references: [survey_submission_id], onDelete: Cascade)
  item       SurveyItem       @relation(fields: [survey_item_id], references: [survey_item_id])

  @@index([survey_submission_id])
  @@index([survey_item_id])
}

model Event {
  event_id    Int       @id @default(autoincrement())
  user_id     Int
  event_type  EventType
  metadata    Json?
  occurred_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id, occurred_at])
}

model PracticeSummary {
  practice_id      Int          @id @default(autoincrement())
  user_id          Int
  practice_type    PracticeType
  correct_count    Int          @default(0)
  attempt_count    Int          @default(0)
  duration_seconds Int?
  occurred_at      DateTime     @default(now())

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

enum EducationLevel {
  high_school
  university
  other
}

enum Role {
  student
  facilitator
  admin
}

enum Device {
  PC
  mobile
  tablet
}

enum ActivityType {
  arithmetic
  algebra
  problems
  statistics
  exercise
  quiz
  flashcard
}

enum DifficultyLevel {
  basic
  intermediate
  advanced
}

enum Status {
  completed
  pending
  in_progress
}

enum AssessmentType {
  pretest
  posttest
}

enum MessageType {
  hint
  explanation
  motivation
}

enum InternetConnection {
  high
  medium
  low
}

enum Gender {
  male
  female
  other
}

enum MathLevel {
  beginner
  intermediate
  advanced
}

enum AssignmentGroup {
  GE
  GC
}

enum AssignmentMethod {
  azar
  emparejamiento
}

enum SurveyInstrument {
  motivacion
  autonomia
  tam
  satisfaccion
}

enum SurveyTimepoint {
  pre
  post
  exit
  follow_up
}

enum EventType {
  session_start
  session_end
  hint
  correct
  incorrect
  streak
  goal_met
}

enum PracticeType {
  exercise
  quiz
  flashcard
}
